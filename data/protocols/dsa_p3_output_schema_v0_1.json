{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsa_p3_output_schema_v0_1",
  "title": "DSA evidence-conditioned patch-gating response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "confidence",
    "concise_rationale",
    "evidence_used",
    "uncertainty"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["accept", "reject", "escalate"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "concise_rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "evidence_used": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    }
  }
}
