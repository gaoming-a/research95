ARG TOOLCHAIN_IMAGE=dsa2026-p4-toolchains:bootstrap-v0_1
FROM ${TOOLCHAIN_IMAGE}

ARG TASK_CONTEXT
ARG TASK_ID
ARG PROJECT
ARG PYTHON_ENV
ARG BUGGY_COMMIT
ARG FIXED_COMMIT

COPY ${TASK_CONTEXT}/buggy_source/ /opt/dsa2026/task/buggy_source/
COPY ${TASK_CONTEXT}/fixed_tests/ /opt/dsa2026/task/fixed_tests/
COPY ${TASK_CONTEXT}/metadata/ /opt/dsa2026/task/metadata/
COPY containers/dsa2026_p4/build_task_environment.sh /opt/dsa2026/bin/build_task_environment.sh

RUN chmod 0755 /opt/dsa2026/bin/build_task_environment.sh \
    && /opt/dsa2026/bin/build_task_environment.sh "${PYTHON_ENV}"

COPY scripts/dsa2026_p4_container_worker.py /opt/dsa2026/bin/dsa2026_p4_container_worker.py
RUN chmod 0755 /opt/dsa2026/bin/dsa2026_p4_container_worker.py

ENV DSA_P4_TASK_ROOT=/opt/dsa2026/task
ENV DSA_P4_PYTHON_ENV=${PYTHON_ENV}
ENV PYTHONHASHSEED=0
ENV TZ=UTC
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

LABEL org.opencontainers.image.title="DSA 2026 P4 task environment"
LABEL org.opencontainers.image.description="Pre-transform task source and dependency environment"
LABEL dsa2026.p4.task_id="${TASK_ID}"
LABEL dsa2026.p4.project="${PROJECT}"
LABEL dsa2026.p4.python_env="${PYTHON_ENV}"
LABEL dsa2026.p4.buggy_commit="${BUGGY_COMMIT}"
LABEL dsa2026.p4.fixed_commit="${FIXED_COMMIT}"
LABEL dsa2026.p4.candidate_materialized="false"
LABEL dsa2026.p4.model_api_called="false"

ENTRYPOINT ["/opt/dsa2026/bin/dsa2026_p4_container_worker.py"]
